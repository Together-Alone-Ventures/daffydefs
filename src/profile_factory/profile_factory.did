type DaffyError = variant {
  ProfileDeleted : record { message : text };
  InvalidInput : record { message : text };
  ProfileNotFound : record { message : text };
  NotAuthorized : record { message : text };
  CanisterCallFailed : record { message : text };
  AlreadyExists : record { message : text };
  InvalidWord : record { message : text };
  RateLimitExceeded : record { message : text };
};
type Result = variant { Ok; Err : DaffyError };
type Result_1 = variant { Ok : principal; Err : DaffyError };
service : () -> {
  // Delete the caller's profile canister. Stops it, deletes it,
  // and removes the mapping. No tombstone — resolve() will return
  // ProfileNotFound for this principal going forward.
  delete_profile_canister : () -> (Result);
  get_cycle_balance : () -> (nat) query;
  get_or_create_profile_canister : () -> (Result_1);
  // Resolve a principal to its profile canister ID.
  // Returns ProfileNotFound for both never-existed and deleted principals.
  resolve : (principal) -> (Result_1) query;
  version : () -> (text) query;
}
